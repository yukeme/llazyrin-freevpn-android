<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#D90C140F" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#4034D399"
                        android:endColor="#1A10B981" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#B334D399" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#C80A0F0C" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#22FFFFFF"
                        android:endColor="#10FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#73FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
