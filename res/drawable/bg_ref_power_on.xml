<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000FF87">
    <item>
        <layer-list>
            <!-- Layer 1: Outer laser-sharp neon border -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0D2B17" />
                    <stroke
                        android:width="2dp"
                        android:color="#00FF87" />
                </shape>
            </item>

            <!-- Layer 2: Inner radiant core -->
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:centerX="0.5"
                        android:centerY="0.5"
                        android:endColor="#0E2917"
                        android:gradientRadius="60%"
                        android:startColor="#1B522E"
                        android:type="radial" />
                    <stroke
                        android:width="1dp"
                        android:color="#34D078" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
