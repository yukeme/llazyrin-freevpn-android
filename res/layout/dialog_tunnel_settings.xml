<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_modal"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Modal Top Bar: Left title block, Right exit button (No Help button) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/btnTunnelBack"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="МАРШРУТИЗАЦИЯ И DNS"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="@string/tunnel_title_upper"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnTunnelBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_btn"
            android:clickable="true"
            android:contentDescription="@string/btn_close"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="16sp" />
        </FrameLayout>
    </RelativeLayout>

    <!-- 3-Segmented Mode Switcher: Правила | Домены | Geoflags (Flat M3 Surface) -->
    <FrameLayout
        android:id="@+id/layoutTabContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_m3_segmented_flat"
        android:padding="3dp">

        <!-- Animated Morphing Capsule Indicator -->
        <View
            android:id="@+id/viewTabIndicatorCapsule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/bg_m3_segment_pill_flat" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Tab 1: Rules -->
            <TextView
                android:id="@+id/tabRules"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tunnel_tab_rules"
                android:textColor="#10B981"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Tab 2: Domains -->
            <TextView
                android:id="@+id/tabDomains"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tunnel_tab_domains"
                android:textColor="#758678"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Tab 3: Geoflags -->
            <TextView
                android:id="@+id/tabGeoFiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tunnel_tab_geofiles"
                android:textColor="#758678"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Main Scrollable Tab Panels -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- PANEL 1: RULES -->
            <LinearLayout
                android:id="@+id/panelRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Description Banner / Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tunnel_rules_desc"
                    android:textColor="#94A3B8"
                    android:textSize="12.5sp" />

                <!-- Section: Ready Presets -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="ГОТОВЫЕ СЦЕНАРИИ"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Preset Card 1: Russian Traffic Direct -->
                <LinearLayout
                    android:id="@+id/cardBypassRu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_m3_server_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tunnel_preset_ru_title"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/tunnel_preset_ru_desc"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Toggle Switch -->
                    <FrameLayout
                        android:id="@+id/toggleBypassRuTrack"
                        android:layout_width="48dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_toggle_track_off"
                        android:clickable="false"
                        android:focusable="false">

                        <View
                            android:id="@+id/toggleBypassRuThumb"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="3dp"
                            android:background="@drawable/bg_toggle_thumb" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Preset Card 2: Popular Services via VPN -->
                <LinearLayout
                    android:id="@+id/cardPopularVpn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_m3_server_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tunnel_preset_popular_title"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/tunnel_preset_popular_desc"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Toggle Switch -->
                    <FrameLayout
                        android:id="@+id/togglePopularVpnTrack"
                        android:layout_width="48dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_toggle_track_off"
                        android:clickable="false"
                        android:focusable="false">

                        <View
                            android:id="@+id/togglePopularVpnThumb"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="3dp"
                            android:background="@drawable/bg_toggle_thumb" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Section: Protection & DNS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="ЗАЩИТА И БЕЗОПАСНОСТЬ"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Grouped Card for Kill Switch, Auto-Connect, and Auto-Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_m3_server_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Kill Switch Row -->
                    <LinearLayout
                        android:id="@+id/rowKillSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="Kill Switch"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/badgeKillSwitch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_m3_chip_active"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text="@string/pref_kill_switch_badge"
                                    android:textColor="#10B981"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/pref_kill_switch_desc"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Toggle -->
                        <FrameLayout
                            android:id="@+id/toggleKillSwitchTrack"
                            android:layout_width="48dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_toggle_track_off"
                            android:clickable="false"
                            android:focusable="false">

                            <View
                                android:id="@+id/toggleKillSwitchThumb"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="3dp"
                                android:background="@drawable/bg_toggle_thumb" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#1FFFFFFF" />

                    <!-- Auto-Connect Row -->
                    <LinearLayout
                        android:id="@+id/rowAutoConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="Автоподключение"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/badgeAutoConnect"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_m3_chip_active"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text="@string/pref_auto_connect_badge"
                                    android:textColor="#10B981"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/pref_auto_connect_desc"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Toggle -->
                        <FrameLayout
                            android:id="@+id/toggleAutoConnectTrack"
                            android:layout_width="48dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_toggle_track_off"
                            android:clickable="false"
                            android:focusable="false">

                            <View
                                android:id="@+id/toggleAutoConnectThumb"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="3dp"
                                android:background="@drawable/bg_toggle_thumb" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#1FFFFFFF" />

                    <!-- Auto-Switch Server (Failover) Row -->
                    <LinearLayout
                        android:id="@+id/rowAutoSwitchServerTunnel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="Автопереключение узлов"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/badgeAutoSwitch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_m3_chip_active"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text="FAILOVER"
                                    android:textColor="#10B981"
                                    android:textSize="9.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Автосмена узла при скачках пинга (>280 мс) или обрыве связи"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Toggle -->
                        <FrameLayout
                            android:id="@+id/toggleAutoSwitchServerTrack"
                            android:layout_width="48dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_toggle_track_off"
                            android:clickable="false"
                            android:focusable="false">

                            <View
                                android:id="@+id/toggleAutoSwitchServerThumb"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="3dp"
                                android:background="@drawable/bg_toggle_thumb" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: DNS Servers -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="ШИФРОВАНИЕ DNS"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- DNS Card 1: Cloudflare -->
                <LinearLayout
                    android:id="@+id/cardDnsCloudflare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dns_card_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/indicatorDnsCloudflare"
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#10B981"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_cloudflare_title"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dns_cloudflare_servers"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DNS Card 2: Google -->
                <LinearLayout
                    android:id="@+id/cardDnsGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dns_card_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/indicatorDnsGoogle"
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="○"
                        android:textColor="#5A6B5C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_google_title"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dns_google_servers"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DNS Card 3: AdGuard -->
                <LinearLayout
                    android:id="@+id/cardDnsAdguard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_dns_card_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/indicatorDnsAdguard"
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="○"
                        android:textColor="#5A6B5C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dns_adguard_title"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dns_adguard_desc"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Countries -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="МАРШРУТИЗАЦИЯ ПО СТРАНАМ (IP)"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Выберите географические зоны для прямого обхода или туннелирования:"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />

                <!-- Dynamic Geo Country Chips Container -->
                <LinearLayout
                    android:id="@+id/layoutGeoCountryChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- PANEL 2: DOMAINS -->
            <LinearLayout
                android:id="@+id/panelDomains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tunnel_domains_desc"
                    android:textColor="#94A3B8"
                    android:textSize="12.5sp" />

                <!-- Input Row: Input + Add Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCustomDomain"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_m3_input_flat"
                        android:hint="@string/tunnel_domain_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="13.5sp" />

                    <FrameLayout
                        android:id="@+id/btnAddDomain"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_m3_apply_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCustomDomainsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- PANEL 3: GEOFILES / GEOFLAGS -->
            <LinearLayout
                android:id="@+id/panelGeoFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="ГЕО-ПРАВИЛА XRAY"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tunnel_georules_desc"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <!-- Input Row: Input + Add Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etGeoRule"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_m3_input_flat"
                        android:hint="@string/tunnel_georule_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textNoSuggestions"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="13.5sp" />

                    <FrameLayout
                        android:id="@+id/btnAddGeoRule"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_m3_apply_btn"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutGeoRulesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical" />

                <!-- Geo-files status card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="БАЗЫ ДАННЫХ GEOIP / GEOSITE"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_m3_server_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tunnel_geofiles_names"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/tunnel_geofiles_desc"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnUpdateGeoFiles"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_m3_icon_btn_flat"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/btn_refresh_servers"
                            android:src="@drawable/ic_refresh"
                            android:tint="#10B981" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Apply Container (Clean Flat Bar, Zero Gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_m3_sheet_footer_flat"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnApplyTunnel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_m3_apply_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="ПРИМЕНИТЬ НАСТРОЙКИ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
