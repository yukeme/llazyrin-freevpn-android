<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40E3B341">
    <item>
        <layer-list>
            <!-- Layer 0: Ambient Amber/Gold Outer Glow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="4dp"
                        android:color="#4DE3B341" />
                </shape>
            </item>

            <!-- Layer 1: Titanium Bevel Ring with Amber Rim -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#2D2515"
                        android:centerColor="#1B1710"
                        android:endColor="#0B1019"
                        android:type="linear" />
                    <stroke
                        android:width="2dp"
                        android:color="#80E3B341" />
                </shape>
            </item>

            <!-- Layer 2: Core Chamber -->
            <item
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp"
                android:top="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#221C12"
                        android:centerColor="#15120B"
                        android:endColor="#06090E"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#66E3B341" />
                </shape>
            </item>

            <!-- Layer 3: Dashed tech ring -->
            <item
                android:bottom="14dp"
                android:left="14dp"
                android:right="14dp"
                android:top="14dp">
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#66E3B341"
                        android:dashWidth="8dp"
                        android:dashGap="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
