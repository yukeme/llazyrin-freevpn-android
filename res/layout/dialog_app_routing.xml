<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_modal"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header: 8dp grid aligned, zero text or close-button clipping -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="ПРОКСИ ДЛЯ ПРИЛОЖЕНИЙ"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Раздельное туннелирование"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseAppRouting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_close_btn"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3-Segmented Mode Switcher: ВЫКЛ | ВКЛ | ОБХОД (Flat M3 Surface) -->
    <FrameLayout
        android:id="@+id/layoutModeContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_m3_segmented_flat"
        android:padding="3dp">

        <!-- Animated Morphing Capsule Indicator -->
        <View
            android:id="@+id/viewModeIndicatorCapsule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/bg_m3_segment_pill_flat" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Mode ALL (ВЫКЛ) -->
            <TextView
                android:id="@+id/btnModeAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ВЫКЛ"
                android:textColor="#10B981"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Mode ONLY_SELECTED (ВКЛ) -->
            <TextView
                android:id="@+id/btnModeOnlySelected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ВКЛ"
                android:textColor="#758678"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Mode BYPASS_SELECTED (ОБХОД) -->
            <TextView
                android:id="@+id/btnModeBypassSelected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ОБХОД"
                android:textColor="#758678"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mode Description Card: Unified Flat Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_m3_server_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Режим: Туннель для всех (ВЫКЛ)"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="VPN шифрует трафик всех программ без исключений."
            android:textColor="#94A3B8"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Category Filter Bar (Grid/Horizontal Aligned) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Filter: Все -->
            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Все приложения"
                android:textColor="#10B981"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Filter: Шпионские / Слежка -->
            <TextView
                android:id="@+id/chipFilterSpyware"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🛡️ Шпионские / РФ"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp" />

            <!-- Filter: Google сервисы -->
            <TextView
                android:id="@+id/chipFilterGoogle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="+ Google сервисы"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp" />

            <!-- Filter: Только выбранные -->
            <TextView
                android:id="@+id/chipFilterSelected"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="★ Выбранные"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Quick Action Tool Buttons: Horizontal Scrollable & Clean Spaced -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- 1. Select All In View -->
            <TextView
                android:id="@+id/chipSelectVisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✓ Все"
                android:textColor="#10B981"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- 2. Clear All -->
            <TextView
                android:id="@+id/chipClearAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✕ Сброс"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />

            <!-- 3. Invert -->
            <TextView
                android:id="@+id/chipInvert"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⇄ Инверт"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />

            <!-- 4. Toggle System Apps -->
            <TextView
                android:id="@+id/chipToggleSystem"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_m3_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⚙️ С системными"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Input Bar & Count Badge (40dp uniform height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearchApp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Поиск приложения…"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_m3_chip_active"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Выбрано: 0"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Apps List View & Loading Progress -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvInstalledApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="#14FFFFFF"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="true"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbarThumbVertical="@drawable/bg_sheet_handle" />

        <ProgressBar
            android:id="@+id/pbLoadingApps"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#10B981" />

        <TextView
            android:id="@+id/tvEmptyList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ничего не найдено"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Apply & Save Bar (Clean Flat Bar, Zero Gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_m3_sheet_footer_flat"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnSaveAppRouting"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_m3_apply_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="СОХРАНИТЬ И ПРИМЕНИТЬ"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>