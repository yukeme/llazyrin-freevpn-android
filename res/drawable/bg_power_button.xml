<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000FF87">
    <item>
        <layer-list>
            <!-- Layer 0: Ambient Outer Glow / Drop Shadow Rim -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="4dp"
                        android:color="#2A00FF87" />
                </shape>
            </item>

            <!-- Layer 1: 3D Bevel Titanium Outer Ring -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#253246"
                        android:centerColor="#141E2C"
                        android:endColor="#0B1019"
                        android:type="linear" />
                    <stroke
                        android:width="2dp"
                        android:color="#4D00FF87" />
                </shape>
            </item>

            <!-- Layer 2: Recessed Dark Cyber Core Chamber -->
            <item
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp"
                android:top="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#16202E"
                        android:centerColor="#0E1520"
                        android:endColor="#06090E"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#1F3D2F" />
                </shape>
            </item>

            <!-- Layer 3: Tech Inner Laser Containment Ring -->
            <item
                android:bottom="14dp"
                android:left="14dp"
                android:right="14dp"
                android:top="14dp">
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#3300FF87"
                        android:dashWidth="8dp"
                        android:dashGap="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
