<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Outer Glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="2dp"
                        android:color="#4000FF87" />
                </shape>
            </item>

            <!-- Neon Pill Body -->
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#5CFFAD"
                        android:endColor="#00E676"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#80FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
