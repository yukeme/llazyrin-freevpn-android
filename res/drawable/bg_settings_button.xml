<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2634D399">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#C80D140F" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#20FFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#73FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
