<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPermissionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_modal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/btnClosePermissionHelp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="СИСТЕМНЫЙ ДОСТУП ANDROID"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Разрешение на VPN"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Система Android отклонила запрос создания туннеля"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnClosePermissionHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_btn"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="16sp" />
        </FrameLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Amber Warning Card: Active VPN or Always-on -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 1. Отключите «Всегда включено» у другого VPN"
                    android:textColor="#FDE68A"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2.5dp"
                    android:text="Если напротив другого приложения (например, Happ) написано «Всегда включено», Android аппаратно блокирует запрос разрешений для любых других VPN.

1. Нажмите на шестерёнку ⚙️ напротив приложения «Всегда включено».
2. Выключите переключатель «Всегда включено».
3. Добавлять наше приложение через 3 точки не нужно — оно появится в списке само сразу после первого разрешения."
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Card 2: Tapjacking / Floating Overlays -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_preference_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ 2. Плавающие пузыри чатов и фильтры"
                    android:textColor="#A7F3D0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Плавающие пузыри (Telegram, WhatsApp) или фильтры синего света блокируют нажатия в системном окне Android (защита от Tapjacking). Временно закройте их перед подключением."
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Action 1: Open System VPN Settings (Primary Emerald) -->
            <TextView
                android:id="@+id/btnOpenVpnSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_emerald_gradient"
                android:gravity="center"
                android:text="⚙️ Открыть настройки VPN Android"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Action 2: Retry Permission Request (Secondary Outlined) -->
            <TextView
                android:id="@+id/btnRetryVpnPermission"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary_privacy"
                android:gravity="center"
                android:text="⚡ Повторить системный запрос"
                android:textColor="#A7F3D0"
                android:textSize="13.5sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Action 3: Dismiss Text Button -->
            <TextView
                android:id="@+id/btnDismissPermissionHelp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Закрыть"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
