<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer faint emerald rim -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2.5dp"
                android:color="#2078C25D" />
        </shape>
    </item>
    <!-- Segmented orbital ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.6dp"
                android:color="#7078C25D"
                android:dashGap="8dp"
                android:dashWidth="13dp" />
        </shape>
    </item>
    <!-- Fine inner concentric guide ring -->
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#3578C25D" />
        </shape>
    </item>
</layer-list>
