<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#35E3B341">
    <item>
        <layer-list>
            <!-- Layer 1: Outer amber ignition rim -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#1A1E10" />
                    <stroke
                        android:width="2dp"
                        android:color="#E3B341" />
                </shape>
            </item>

            <!-- Layer 2: Inner pulsing amber core -->
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:centerX="0.5"
                        android:centerY="0.5"
                        android:endColor="#1A1A0C"
                        android:gradientRadius="60%"
                        android:startColor="#3D3812"
                        android:type="radial" />
                    <stroke
                        android:width="1dp"
                        android:color="#8A7E24" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
