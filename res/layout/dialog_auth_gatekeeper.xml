<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAuthGatekeeperRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- Card Obsidian Frosted Container -->
            <LinearLayout
                android:id="@+id/cardAuthGatekeeperContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_gatekeeper_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="26dp"
                android:paddingEnd="22dp"
                android:paddingBottom="26dp">

                <!-- Glowing Lock Capsule -->
                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_lock_capsule">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🔒"
                        android:textSize="30sp" />
                </FrameLayout>

                <!-- Title: Авторизация -->
                <TextView
                    android:id="@+id/tvGatekeeperTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Авторизация"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Body text: Подписка на @llazyrin -->
                <TextView
                    android:id="@+id/tvGatekeeperBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Для полноценного использования приложения необходимо подписаться на наш ТГ-канал @llazyrin"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <!-- Mandatory Privacy Consent Checkbox -->
                <LinearLayout
                    android:id="@+id/layoutGatekeeperPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbGatekeeperPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                    <TextView
                        android:id="@+id/tvGatekeeperPrivacyLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Согласен с правилами конфиденциальности"
                        android:textColor="#10B981"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Action Button 1: Подписаться на канал -->
                <FrameLayout
                    android:id="@+id/btnGatekeeperSubscribe"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_emerald_gradient"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✈  Подписаться на канал"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Action Button 2: Я подписался -->
                <FrameLayout
                    android:id="@+id/btnGatekeeperCheckSub"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_gatekeeper_frosted"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Я подписался"
                        android:textColor="#10B981"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Feedback / Status message -->
                <TextView
                    android:id="@+id/tvGatekeeperStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Emergency 5-Minute Telegram Access Section -->
                <LinearLayout
                    android:id="@+id/cardGatekeeperEmergency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_auth_emergency_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Экстренный доступ в Telegram (5 минут)"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Временный туннель для входа в Telegram и оформления подписки"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <!-- Community Server Selector Header -->
                    <TextView
                        android:id="@+id/tvGatekeeperCommunityHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Лучшее от сообщества:"
                        android:textColor="#7A8C7D"
                        android:textSize="12sp" />

                    <!-- Horizontal Server Selector Row -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutGatekeeperServerChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Timer + Emergency Connect Action Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Timer Monospace Display -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_gatekeeper_timer_badge"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/tvGatekeeperTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="05:00"
                                android:textColor="#10B981"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:typeface="monospace" />
                        </FrameLayout>

                        <!-- Start 5 Min / Extend button -->
                        <FrameLayout
                            android:id="@+id/btnGatekeeperEmergencyVpn"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_emerald_gradient"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvGatekeeperEmergencyBtnText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Запустить 5 мин"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
