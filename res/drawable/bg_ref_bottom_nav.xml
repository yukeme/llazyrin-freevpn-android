<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9080D0A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#12FFFFFF"
                android:centerColor="#24FFFFFF"
                android:endColor="#45FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
